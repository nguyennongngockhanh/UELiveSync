+# Phase 9B.6B.3: persistent sidecar state file name
+SIDECAR_STATE_FILENAME = "sidecar_state.json"
+TEXTURE_MANIFEST_FILENAME = "texture_manifest.json"
+TEXTURE_MANIFEST_SCHEMA_VERSION = 2
+
