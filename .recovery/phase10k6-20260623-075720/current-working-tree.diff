+// =========================================================
+// IMPORT SUBSYSTEM CALLBACK — Per-file texture import
+// diagnostics (Phase 10K.5)
+// =========================================================
+// Fires once per imported texture after the factory completes
+// but before PostEditChange.  Records source filename, timing,
+// and settings before/after normal-map detection.
+// =========================================================
+
+void UUELiveSyncSubsystem::
+OnAssetPostImport(UFactory* Factory, UObject* CreatedObject)
+{
+    if (!Factory || !CreatedObject)
+        return;
+
+    UTexture2D* Texture = Cast<UTexture2D>(CreatedObject);
+    if (!Texture)
+        return;
+
+    FString SourceFilename = UFactory::GetCurrentFilename();
+    if (SourceFilename.IsEmpty())
+        return;
+
+    int32 TransactionId = Stats.DisposableProbeTransactionId.load(std::memory_order_relaxed);
+    if (TransactionId == 0)
+    {
+        // Not in a probe transaction — log as observation only
+        UE_LOG(LogLiveSync, Log,
+            TEXT("[PROBE][OBSERVE] source=%s asset=%s"),
+            *SourceFilename, *Texture->GetPathName());
+        return;
+    }
+
+    // Find or create probe entry for this source file
+    FString BaseName = FPaths::GetBaseFilename(SourceFilename).ToLower();
+
+    // Use the texture asset to detect settings after normal-map detection
+    int32 CompressionVal = static_cast<int32>(Texture->CompressionSettings);
+    int32 LODGroupVal = static_cast<int32>(Texture->LODGroup);
+
+    UE_LOG(LogLiveSync, Log,
+        TEXT("[PROBE][POST_IMPORT] transactionId=%d source=%s asset=%s "
+             "compression=%d sRGB=%d LODGroup=%d resolution=%dx%d"),
+        TransactionId, *SourceFilename, *Texture->GetPathName(),
+        CompressionVal, Texture->SRGB ? 1 : 0, LODGroupVal,
+        Texture->GetSizeX(), Texture->GetSizeY());
+}
+
+// =========================================================
+// DISPOSABLE IMPORT PROBE — Cold-import diagnostics
+// (Phase 10K.5)
+// =========================================================
+// Imports texture copies into disposable content paths and
+// records per-file timing and settings observations.
+// =========================================================
+
+void UUELiveSyncSubsystem::
+ConsoleRunImportProbe(const TArray<FString>& Args)
+{
+    if (Args.Num() < 1)
+    {
+        UE_LOG(LogLiveSync, Warning,
+            TEXT("[PROBE] Usage: UE.LiveSync.ImportProbe <scenario> [runId]"));
+        return;
+    }
+
+    FString Scenario = Args[0].ToUpper();
+    FString RunId = (Args.Num() > 1) ? Args[1] : FString::FromInt(FPlatformTime::Seconds());
+
+    // Map scenario identifier to list of source files
+    // Source files are copies in the sidecar cache
+    FString SidecarCacheDir = FPaths::ProjectSavedDir() / TEXT("UELiveSync") / TEXT("SidecarCache");
+    FString DestBase = TEXT("/Game/UELiveSync/Diagnostics/ImportProbe") / RunId / Scenario;
+
+    // Source files for each scenario — use cached sidecar textures from known paths
+    TArray<FString> SourceFiles;
+    TArray<FString> ChannelLabels;
+
+    auto AddSource = [&](const FString& Name, const FString& Channel)
+    {
+        // Check multiple likely locations: Project Saved dir, Project Content dir, etc.
+        TArray<FString> SearchPaths = {
+            FPaths::Combine(FPaths::ProjectSavedDir(), TEXT("UELiveSync"), TEXT("SidecarCache"), Name + TEXT(".png")),
+            FPaths::Combine(FPaths::ProjectContentDir(), TEXT("UELiveSync"), TEXT("SidecarCache"), Name + TEXT(".png")),
+        };
+        for (const FString& Path : SearchPaths)
+        {
+            if (IFileManager::Get().FileExists(*Path))
+            {
+                SourceFiles.Add(Path);
+                ChannelLabels.Add(Channel);
+                return;
+            }
+        }
+        // File not found — use a placeholder path for the diagnostic
+        UE_LOG(LogLiveSync, Warning,
+            TEXT("[PROBE] Source file not found: %s.png — will log placeholder"),
+            *Name);
+        SourceFiles.Add(Name + TEXT(".png"));
+        ChannelLabels.Add(Channel);
+    };
+
+    switch (Scenario[0])
+    {
+        case TEXT('A'):
+            AddSource(TEXT("Marble"), TEXT("BaseColor"));
+            break;
+        case TEXT('B'):
+            AddSource(TEXT("Marble_Rough"), TEXT("Roughness"));
+            break;
+        case TEXT('C'):
+            AddSource(TEXT("Marble_Normal"), TEXT("Normal"));
+            break;
+        case TEXT('D'):
+            AddSource(TEXT("Wood"), TEXT("BaseColor"));
+            break;
+        case TEXT('E'):
+            AddSource(TEXT("Wood_Rough"), TEXT("Roughness"));
+            break;
+        case TEXT('F'):
+            AddSource(TEXT("Wood_Normal"), TEXT("Normal"));
+            break;
+        case TEXT('G'):
+            AddSource(TEXT("Marble"), TEXT("BaseColor"));
+            AddSource(TEXT("Marble_Rough"), TEXT("Roughness"));
+            break;
+        case TEXT('H'):
+            AddSource(TEXT("Marble_Normal"), TEXT("Normal"));
+            AddSource(TEXT("Wood_Normal"), TEXT("Normal"));
+            break;
+        case TEXT('I'):
+            AddSource(TEXT("Marble"), TEXT("BaseColor"));
+            AddSource(TEXT("Marble_Rough"), TEXT("Roughness"));
+            AddSource(TEXT("Marble_Normal"), TEXT("Normal"));
+            AddSource(TEXT("Wood"), TEXT("BaseColor"));
+            AddSource(TEXT("Wood_Rough"), TEXT("Roughness"));
+            AddSource(TEXT("Wood_Normal"), TEXT("Normal"));
+            break;
+        default:
+            UE_LOG(LogLiveSync, Warning,
+                TEXT("[PROBE] Unknown scenario: %s"), *Scenario);
+            return;
+    }
+
+    if (SourceFiles.Num() == 0)
+    {
+        UE_LOG(LogLiveSync, Warning,
+            TEXT("[PROBE] No source files for scenario %s"), *Scenario);
+        return;
+    }
+
+    // Begin probe transaction
+    int32 TransactionId = ++Stats.DisposableProbeTransactionId;
+
+    UE_LOG(LogLiveSync, Log,
+        TEXT("[PROBE][BEGIN] transactionId=%d scenario=%s runId=%s files=%d dest=%s"),
+        TransactionId, *Scenario, *RunId, SourceFiles.Num(), *DestBase);
+
+    // Record source file metadata
+    for (int32 i = 0; i < SourceFiles.Num(); ++i)
+    {
+        const FString& Src = SourceFiles[i];
+        int64 FileSize = IFileManager::Get().FileSize(*Src);
+        if (FileSize == INDEX_NONE) FileSize = 0;
+
+        FString CanonicalKey = FPaths::GetBaseFilename(Src).ToLower();
+
+        UE_LOG(LogLiveSync, Log,
+            TEXT("[PROBE][INPUT_QUEUED] transactionId=%d probeId=%d canonicalKey=%s "
+                 "sourceFilename=%s channel=%s sourceBytes=%lld"),
+            TransactionId, i, *CanonicalKey, *Src, *ChannelLabels[i], FileSize);
+    }
+
+    // Import each file individually into disposable destinations
+    double BatchBegin = FPlatformTime::Seconds();
+    UE_LOG(LogLiveSync, Log,
+        TEXT("[PROBE][BATCH_BEGIN] transactionId=%d sourceCount=%d"),
+        TransactionId, SourceFiles.Num());
+
+    IAssetTools& AssetTools = FAssetToolsModule::GetModule().Get();
+
+    for (int32 i = 0; i < SourceFiles.Num(); ++i)
+    {
+        const FString& Src = SourceFiles[i];
+
+        // Create a unique destination per file
+        FString FileBase = FPaths::GetBaseFilename(Src);
+        FString UniqueDest = DestBase / FileBase;
+
+        // Prepare automated import data
+        UAutomatedAssetImportData* ImportData = NewObject<UAutomatedAssetImportData>();
+        ImportData->GroupName = TEXT("UELiveSync-Probe");
+        ImportData->Filenames = { Src };
+        ImportData->DestinationPath = UniqueDest;
+        ImportData->bReplaceExisting = false;
+        ImportData->bSkipReadOnly = false;
+
+        double ImportBegin = FPlatformTime::Seconds();
+        TArray<UObject*> ImportedAssets = AssetTools.ImportAssetsAutomated(ImportData);
+        double ImportElapsed = (FPlatformTime::Seconds() - ImportBegin) * 1000.0;
+
+        if (ImportedAssets.Num() > 0 && ImportedAssets[0])
+        {
+            UTexture2D* Tex = Cast<UTexture2D>(ImportedAssets[0]);
+            if (Tex)
+            {
+                int32 CompressionVal = static_cast<int32>(Tex->CompressionSettings);
+                bool bSRGB = Tex->SRGB;
+                int32 LODGroupVal = static_cast<int32>(Tex->LODGroup);
+
+                UE_LOG(LogLiveSync, Log,
+                    TEXT("[PROBE][BATCH_RETURN] transactionId=%d probeId=%d "
+                         "canonicalKey=%s assetPath=%s importMs=%.2f "
+                         "compression=%d sRGB=%d LODGroup=%d resolution=%dx%d"),
+                    TransactionId, i, *FileBase.ToLower(), *Tex->GetPathName(),
+                    ImportElapsed, CompressionVal, bSRGB ? 1 : 0, LODGroupVal,
+                    Tex->GetSizeX(), Tex->GetSizeY());
+            }
+            else
+            {
+                UE_LOG(LogLiveSync, Warning,
+                    TEXT("[PROBE][BATCH_RETURN] transactionId=%d probeId=%d "
+                         "reason=not_a_texture assetClass=%s"),
+                    TransactionId, i, *ImportedAssets[0]->GetClass()->GetName());
+            }
+        }
+        else
+        {
+            UE_LOG(LogLiveSync, Warning,
+                TEXT("[PROBE][BATCH_RETURN] transactionId=%d probeId=%d "
+                     "reason=import_failed"),
+                TransactionId, i);
+        }
+    }
+
+    double BatchElapsed = (FPlatformTime::Seconds() - BatchBegin) * 1000.0;
+
+    UE_LOG(LogLiveSync, Log,
+        TEXT("[PROBE][END] transactionId=%d scenario=%s runId=%s "
+             "files=%d batchMs=%.2f"),
+        TransactionId, *Scenario, *RunId, SourceFiles.Num(), BatchElapsed);
+}
+
