+# 27B. Future-slice production checks: FFbxScopePhase wiring for each phase
+#      These check the form:
+#        FFbxScopePhase Scope(..., TEXT("phase"), EFbxPhaseKind::Exclusive,
+#                             ..., &PhaseDurations);
+#      All must fail until the production phases are implemented (Slice 3+).
+# ---------------------------------------------------------------------------
+def test_production_phase_wiring():
+    """Verify each production phase will pass &PhaseDurations to FFbxScopePhase."""
+    content = _read(FBX_IMPORTER_CPP)
+    # Phases that must use the destructor-owner accumulator pattern
+    phases = [
+        ("path_validation", None),
+        ("request_parse",  "ValidateVersion"),
+    ]
+    for ph, ordering_hint in phases:
+        # Full wiring check: scope instantiation with phase name, Exclusive kind, and &PhaseDurations
+        scope_re = (
+            r'FFbxScopePhase\s+\w+\('
+            r'[^)]*TEXT\("' + ph + r'"\)'
+            r'[^)]*EFbxPhaseKind::Exclusive'
+            r'[^)]*&PhaseDurations'
+        )
+        scope_match = re.search(scope_re, content, re.DOTALL)
+        _test(f"Production: '{ph}' FFbxScopePhase with Exclusive+&PhaseDurations exists",
+              scope_match is not None,
+              detail=f"phase={ph}: expected "
+                     f"FFbxScopePhase Xxx(..., TEXT(\"{ph}\"), EFbxPhaseKind::Exclusive, ..., &PhaseDurations)")
+
+        # Ordered wiring: if scope exists, verify it begins before the hinted call
+        if ordering_hint and scope_match:
+            after_scope = content[scope_match.start():]
+            hint_match = re.search(re.escape(ordering_hint), after_scope)
+            _test(f"Production: '{ph}' scope begins before {ordering_hint}",
+                  hint_match is not None,
+                  detail=f"phase={ph}: {ordering_hint} should appear after scope start")
+        elif ordering_hint:
+            _test(f"Production: '{ph}' scope begins before {ordering_hint}",
+                  False,
+                  detail=f"phase={ph}: scope not yet implemented — cannot verify ordering")
+
+
