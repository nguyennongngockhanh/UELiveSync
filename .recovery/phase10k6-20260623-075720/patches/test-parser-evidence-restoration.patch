+def _scan_for_phase_name_in_span(content, mask, phase_name, start_pos, end_pos):
+    """Lexical-aware scan for TEXT("phase_name") within [start_pos, end_pos).
+    Stops at: next unmasked '}' at depth 0, next unmasked FFbxScopePhase,
+    end_pos.  Uses mask to skip //, /* */, and string literals.
+    Returns True if TEXT("phase_name") found before any stop condition."""
+    ffbx_pat = re.compile(r'FFbxScopePhase\s+\w+\s*\(')
+    text_pat = re.compile(r'TEXT\s*\(\s*"([^"]*)"\s*\)')
+    depth = 0
+    pos = start_pos
+    while pos < end_pos and pos < len(content):
+        if mask[pos]:
+            pos += 1
+            continue
+        c = content[pos]
+        if c == '{':
+            depth += 1
+            pos += 1
+            continue
+        if c == '}':
+            depth -= 1
+            if depth < 0:
+                return False
+            pos += 1
+            continue
+        if depth == 0 and c == '}':
+            return False
+        # Check for next declaration token
+        if pos + 14 <= len(content) and content[pos:pos+14] == 'FFbxScopePhase':
+            if ffbx_pat.match(content, pos) and not mask[pos]:
+                return False
+        # Check for TEXT macro
+        tm = text_pat.match(content, pos)
+        if tm:
+            if tm.group(1) == phase_name:
+                return True
+            pos = tm.end()
+            continue
+        pos += 1
+    return False
+
