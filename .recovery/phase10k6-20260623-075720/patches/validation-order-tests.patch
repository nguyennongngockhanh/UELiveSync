 # ---------------------------------------------------------------------------
+# 29B. Semantic-regression source tests for request_parse/path_validation
+# ---------------------------------------------------------------------------
+def test_semantic_regression_source_assertions():
+    """Verify exact call counts and ordering invariants in the production
+    LiveSyncFBXImporter.cpp source.
+
+    Enforces:
+      - ValidateVersion runs before FbxPath extraction in HandleImport.
+      - No FbxPath or ObjectName conversion before version validation.
+      - Exactly one FbxPath conversion in HandleImport.
+      - Exactly one ValidatePathSecurity call in HandleImport.
+      - ValidateVersion before ValidatePathSecurity.
+      - ObjectName conversions occur after path_validation block close.
+      - No ObjectName conversion inside request_parse or path_validation blocks.
+      - Full ordering: VV < fbx_start < fbx_end < rp_close
+        < pv_decl < VPS < pv_close < ObjectName.
+    """
+    content = _read(FBX_IMPORTER_CPP)
+    mask = _build_lexical_mask(content)
+
+    ho, hc = _find_handleimport_full_bounds(content, mask)
+    hi_start = ho + 1 if ho >= 0 else 0
+    hi_end = hc if hc >= 0 else len(content)
+
+    _test("Semantic regression: HandleImport bounds found",
+          ho >= 0 and hc > ho, detail=f"hi@{ho},{hc}")
+
+    # --- Count unmasked calls inside HandleImport body ---
+    all_vv = list(re.finditer(r'ValidateVersion\(', content))
+    all_vps = list(re.finditer(r'ValidatePathSecurity\(', content))
+    all_fbx = list(re.finditer(r'FStringFromFixedAnsi\s*\(\s*Request\.FbxPath', content))
+    all_obj = list(re.finditer(r'FStringFromFixedAnsi\s*\(\s*Request\.ObjectName', content))
+
+    hi_vv = [m for m in all_vv if hi_start <= m.start() < hi_end and not any(mask[m.start():m.end()])]
+    hi_vps = [m for m in all_vps if hi_start <= m.start() < hi_end and not any(mask[m.start():m.end()])]
+    hi_fbx = [m for m in all_fbx if hi_start <= m.start() < hi_end and not any(mask[m.start():m.end()])]
+    hi_obj = [m for m in all_obj if hi_start <= m.start() < hi_end and not any(mask[m.start():m.end()])]
+
+    _test("Semantic regression: exactly one ValidateVersion in HandleImport",
+          len(hi_vv) == 1, detail=f"count={len(hi_vv)}")
+    _test("Semantic regression: exactly one ValidatePathSecurity in HandleImport",
+          len(hi_vps) == 1, detail=f"count={len(hi_vps)}")
+    _test("Semantic regression: exactly one FbxPath conversion in HandleImport",
+          len(hi_fbx) == 1, detail=f"count={len(hi_fbx)}")
+
+    # --- ValidateVersion before FbxPath ---
+    if len(hi_vv) == 1 and len(hi_fbx) == 1:
+        vv_pos = hi_vv[0].start()
+        fbx_pos = hi_fbx[0].start()
+        _test("Semantic regression: ValidateVersion before FbxPath",
+              vv_pos < fbx_pos,
+              detail=f"vv@{vv_pos} < fbx@{fbx_pos}")
+    else:
+        _test("Semantic regression: ValidateVersion before FbxPath",
+              False, detail="missing vv or fbx call")
+
+    # --- ValidateVersion before ValidatePathSecurity ---
+    if len(hi_vv) == 1 and len(hi_vps) == 1:
+        vv_pos = hi_vv[0].start()
+        vps_pos = hi_vps[0].start()
+        _test("Semantic regression: ValidateVersion before ValidatePathSecurity",
+              vv_pos < vps_pos,
+              detail=f"vv@{vv_pos} < vps@{vps_pos}")
+    else:
+        _test("Semantic regression: ValidateVersion before ValidatePathSecurity",
+              False, detail="missing vv or vps call")
+
+    # --- ObjectName conversions: none before ValidateVersion ---
+    if len(hi_vv) == 1:
+        vv_pos = hi_vv[0].start()
+        pre_vv_obj = [m for m in hi_obj if m.start() < vv_pos]
+        _test("Semantic regression: no ObjectName conversion before ValidateVersion",
+              len(pre_vv_obj) == 0,
+              detail=f"{len(pre_vv_obj)} ObjectName conversions before ValidateVersion")
+    else:
+        _test("Semantic regression: no ObjectName conversion before ValidateVersion",
+              False, detail="ValidateVersion not found")
+
+    # --- ObjectName conversion exists in HandleImport (deferred after validation) ---
+    _test("Semantic regression: at least one ObjectName conversion in HandleImport",
+          len(hi_obj) >= 1, detail=f"count={len(hi_obj)}")
+
+    # --- ObjectName strictly after path_validation block close ---
+    # Locate request_parse phase declaration and its dedicated block.
+    rp_decls = _find_ffbxscopephase_decls(content, mask, 'request_parse',
+                                           hi_start, hi_end)
+    rp_total, rp_complete = _count_phase_declarations(
+        rp_decls, [inv for _, inv in rp_decls])
+    rp_unique = (rp_total == 1 and rp_complete == 1 and len(rp_decls) == 1)
+    rp_single = rp_decls[0][0] if rp_unique else None
+    rp_block = _find_dedicated_block(content, mask, rp_single.start()) if rp_single else None
+    rp_close = rp_block[1] if rp_block else -1
+
+    # Locate path_validation phase declaration and its dedicated block.
+    pv_decls = _find_ffbxscopephase_decls(content, mask, 'path_validation',
+                                           hi_start, hi_end)
+    pv_total, pv_complete = _count_phase_declarations(
+        pv_decls, [inv for _, inv in pv_decls])
+    pv_unique = (pv_total == 1 and pv_complete == 1 and len(pv_decls) == 1)
+    pv_single = pv_decls[0][0] if pv_unique else None
+    pv_block = _find_dedicated_block(content, mask, pv_single.start()) if pv_single else None
+    pv_close = pv_block[1] if pv_block else -1
+    pv_decl_start = pv_single.start() if pv_single else -1
+
+    # Request_parse phase assertions (structural sanity)
+    _test("Semantic regression: exactly one complete request_parse block",
+          rp_unique and rp_block is not None,
+          detail=f"total={rp_total}, complete={rp_complete}, block={'yes' if rp_block else 'no'}")
+
+    # Path_validation phase assertions (structural sanity)
+    _test("Semantic regression: path_validation block found",
+          pv_unique and pv_block is not None,
+          detail=f"total={pv_total}, complete={pv_complete}, block={'yes' if pv_block else 'no'}")
+
+    # Get FbxPath conversion exact bounds
+    fbx_s, fbx_e = _find_fbxpath_invocation(content, mask, hi_start, hi_end)
+    _test("Semantic regression: FbxPath conversion bounds found",
+          fbx_s >= 0 and fbx_e > fbx_s, detail=f"fbx@{fbx_s},{fbx_e}")
+
+    # Collect exact positions for reporting
+    vv_pos = hi_vv[0].start() if len(hi_vv) == 1 else -1
+    vps_pos = hi_vps[0].start() if len(hi_vps) == 1 else -1
+    first_obj_pos = hi_obj[0].start() if hi_obj else -1
+
+    # No ObjectName inside request_parse block
+    obj_in_rp = [m for m in hi_obj if rp_block and rp_block[0] < m.start() < rp_block[1]]
+    _test("Semantic regression: no ObjectName conversion inside request_parse",
+          len(obj_in_rp) == 0,
+          detail=f"{len(obj_in_rp)} ObjectName conversions inside request_parse")
+
+    # No ObjectName inside path_validation block
+    obj_in_pv = [m for m in hi_obj if pv_block and pv_block[0] < m.start() < pv_block[1]]
+    _test("Semantic regression: no ObjectName conversion inside path_validation",
+          len(obj_in_pv) == 0,
+          detail=f"{len(obj_in_pv)} ObjectName conversions inside path_validation")
+
+    # First ObjectName conversion after path_validation block close
+    _test("Semantic regression: ObjectName conversion after path_validation close",
+          rp_close >= 0 and pv_close >= 0 and first_obj_pos >= 0 and first_obj_pos > pv_close,
+          detail=(f"obj@{first_obj_pos} > pv_close@{pv_close}" if first_obj_pos >= 0 and pv_close >= 0
+                  else f"obj={first_obj_pos}, pv_close={pv_close}"))
+
+    # Full ordering: VV < fbx_start < fbx_end < rp_close < pv_decl < VPS < pv_close < obj
+    ordering_parts = [
+        ("vv", vv_pos), ("fbx_s", fbx_s), ("fbx_e", fbx_e),
+        ("rp_close", rp_close), ("pv_decl", pv_decl_start),
+        ("vps", vps_pos), ("pv_close", pv_close), ("obj", first_obj_pos)
+    ]
+    order_ok = all(
+        ordering_parts[i][1] < ordering_parts[i + 1][1]
+        for i in range(len(ordering_parts) - 1)
+        if ordering_parts[i][1] >= 0 and ordering_parts[i + 1][1] >= 0
+    )
+    order_detail = " < ".join(
+        f"{name}@{pos}" for name, pos in ordering_parts if pos >= 0)
+    _test("Semantic regression: full ordering chain",
+          order_ok, detail=order_detail)
+
+
