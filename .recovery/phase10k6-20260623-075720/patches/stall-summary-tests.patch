+def _evaluate_raii_source(
+    source_text,
+    expected_guards=1,
+    expected_emissions=1,
+):
+    """Evaluate a synthetic C++ HandleImport-like source snippet for
+    RAII correctness.  Returns a dict with computed counts and validity.
+
+    Checks:
+      - guard definition count (struct FFbxTransactionSummary)
+      - guard instance count (FFbxTransactionSummary <name>(...))
+      - STALL_SUMMARY UE_LOG invocation count
+      - PhaseDurations declaration position
+      - guard instance position
+      - first return after transaction allocation
+      - fail-closed prerequisites (all positions present)
+      - explicit ordering validity and failure reasons
+    """
+    result = {
+        "guard_definitions": 0,
+        "guard_instances": 0,
+        "stall_emissions": 0,
+        "phasedurations_pos": -1,
+        "guard_instance_pos": -1,
+        "first_return_after_txn": -1,
+        "txn_alloc_pos": -1,
+        "ordering_valid": False,
+        "failure_reasons": [],
+    }
+
+    # Count guard definitions: struct FFbxTransactionSummary
+    result["guard_definitions"] = len(
+        [m for m in re.finditer(r'struct\s+FFbxTransactionSummary', source_text)]
+    )
+
+    # Count guard instances: FFbxTransactionSummary <identifier> (
+    result["guard_instances"] = sum(
+        1 for _ in re.finditer(r'FFbxTransactionSummary\s+\w+\s*\(', source_text)
+    )
+
+    # Count STALL_SUMMARY UE_LOG invocations (bounded call scanner)
+    result["stall_emissions"] = _count_stall_summary_emissions(source_text)
+
+    # --- Independent position discovery (no cross-dependency) ---
+
+    # Transaction allocation position: find FBXTransactionId assignment
+    txn_pos = source_text.find('FBXTransactionId')
+    result["txn_alloc_pos"] = txn_pos if txn_pos >= 0 else -1
+
+    # PhaseDurations declaration position
+    pd_pos = source_text.find('PhaseDurations')
+    result["phasedurations_pos"] = pd_pos if pd_pos >= 0 else -1
+
+    # Guard instance position: independent search for FFbxTransactionSummary
+    # instance declarations (not struct definitions). Use regex to find the
+    # first valid instance (type + identifier + paren), excluding struct.
+    guard_match = re.search(
+        r'FFbxTransactionSummary\s+\w+\s*\(', source_text
+    )
+    result["guard_instance_pos"] = guard_match.start() if guard_match else -1
+
+    # First return after transaction allocation
+    first_ret = -1
+    if txn_pos >= 0:
+        first_ret = source_text.find('return', txn_pos)
+    result["first_return_after_txn"] = first_ret if first_ret >= 0 else -1
+
+    # --- Fail-closed prerequisites ---
+    all_positions_present = (
+        result["txn_alloc_pos"] >= 0
+        and result["phasedurations_pos"] >= 0
+        and result["guard_instance_pos"] >= 0
+        and result["first_return_after_txn"] >= 0
+    )
+
+    if not all_positions_present:
+        if result["txn_alloc_pos"] < 0:
+            result["failure_reasons"].append("missing_transaction_allocation")
+        if result["phasedurations_pos"] < 0:
+            result["failure_reasons"].append("missing_PhaseDurations")
+        if result["guard_instance_pos"] < 0:
+            result["failure_reasons"].append("missing_guard_instance")
+        if result["first_return_after_txn"] < 0:
+            result["failure_reasons"].append("missing_first_return")
+        result["ordering_valid"] = False
+        result["all_positions_present"] = False
+        result["ordering_valid_detail"] = {
+            "all_positions_present": False,
+            "failure_reasons": list(result["failure_reasons"]),
+        }
+        return result
+
+    result["all_positions_present"] = True
+
+    # --- Ordering validity checks (only when all positions are present) ---
+    ordering_valid = True
+
+    # 1. txn_pos < phasedurations_pos
+    if not (result["txn_alloc_pos"] < result["phasedurations_pos"]):
+        ordering_valid = False
+        result["failure_reasons"].append("PhaseDurations_not_before_guard")
+
+    # 2. phasedurations_pos < guard_instance_pos
+    if not (result["phasedurations_pos"] < result["guard_instance_pos"]):
+        ordering_valid = False
+        result["failure_reasons"].append("PhaseDurations_not_before_guard")
+
+    # 3. guard_instance_pos < first_return_after_txn
+    if not (result["guard_instance_pos"] < result["first_return_after_txn"]):
+        ordering_valid = False
+        result["failure_reasons"].append("guard_not_before_first_return")
+
+    # 4. expected number of emissions
+    if result["stall_emissions"] != expected_emissions:
+        ordering_valid = False
+        if expected_emissions == 1:
+            result["failure_reasons"].append("duplicate_emission")
+
+    # 5. expected number of guard definitions
+    if result["guard_definitions"] != expected_guards:
+        ordering_valid = False
+        if expected_guards == 1:
+            result["failure_reasons"].append("duplicate_guard")
+
+    # 6. No duplicate guard instances
+    if expected_guards == 1 and result["guard_instances"] != 1:
+        ordering_valid = False
+        result["failure_reasons"].append("duplicate_guard")
+
+    result["ordering_valid"] = ordering_valid
+    result["ordering_valid_detail"] = {
+        "all_positions_present": all_positions_present,
+        "failure_reasons": list(result["failure_reasons"]),
+    }
+    return result
+
+
+def _count_stall_summary_emissions(source_text):
+    """Count bounded UE_LOG invocations containing [FBX][STALL_SUMMARY].
+
+    Finds unmasked UE_LOG tokens, then finds matching parentheses,
+    and checks if the invocation text contains the marker.
+    Returns the count.
+    """
+    mask = _build_lexical_mask(source_text)
+    count = 0
+    for m in re.finditer(r'UE_LOG\s*\(', source_text):
+        pos = m.start()
+        # Skip if in comment
+        if mask[pos]:
+            continue
+        # Find matching closing paren
+        open_pos = m.end() - 1  # position of '('
+        depth = 0
+        i = open_pos
+        found_close = False
+        while i < len(source_text):
+            ch = source_text[i]
+            if not mask[i]:
+                if ch == '(':
+                    depth += 1
+                elif ch == ')':
+                    depth -= 1
+                    if depth == 0:
+                        found_close = True
+                        break
+            i += 1
+        if found_close:
+            inv_text = source_text[open_pos:i + 1]
+            if '[FBX][STALL_SUMMARY]' in inv_text:
+                count += 1
+    return count
+
