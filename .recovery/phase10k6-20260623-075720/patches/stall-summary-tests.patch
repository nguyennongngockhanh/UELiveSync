+def _classify_exclusive_fixture(
+    phase_items,
+    exclusive_names,
+    total_ms,
+):
+    """Production-equivalent exclusive-phase classification.
+
+    phase_items: list of (name, duration_ms)
+    exclusive_names: set of phase names considered exclusive
+    total_ms: total transaction duration
+
+    Returns a dict with classification, largestPhase, largestPhaseMs.
+    """
+    candidates = [
+        (name, ms)
+        for name, ms in phase_items
+        if name in exclusive_names and ms > 0.0
+    ]
+
+    candidates.sort(key=lambda item: (-item[1], item[0]))
+
+    measured = sum(
+        ms for name, ms in phase_items
+        if name in exclusive_names
+    )
+
+    excess = max(0.0, measured - total_ms)
+    timing_valid = excess <= 0.5
+
+    if not timing_valid:
+        return {
+            "classification": "INVALID_OVERLAP",
+            "largestPhase": "UNRESOLVED",
+            "largestPhaseMs": 0.0,
+        }
+
+    if not candidates:
+        return {
+            "classification": "UNRESOLVED",
+            "largestPhase": "UNRESOLVED",
+            "largestPhaseMs": 0.0,
+        }
+
+    largest_name, largest_ms = candidates[0]
+
+    if len(candidates) == 1:
+        classification = f"DOMINANT_{largest_name}"
+    else:
+        second_ms = candidates[1][1]
+        classification = (
+            "MIXED"
+            if second_ms >= largest_ms * 0.8
+            else f"DOMINANT_{largest_name}"
+        )
+
+    return {
+        "classification": classification,
+        "largestPhase": largest_name,
+        "largestPhaseMs": largest_ms,
+    }
+
+
+def _compute_coverage(total_ms, measured_ms):
+    """Compute raw coverage percentage: measured/total*100.
+
+    Returns 0.0 when total_ms <= 0.
+    """
+    if total_ms > 0.0:
+        return measured_ms / total_ms * 100.0
+    return 0.0
+
